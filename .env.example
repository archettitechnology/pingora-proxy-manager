# Pingora Proxy Manager Environment Configuration

# JWT Secret for authentication (CHANGE IN PRODUCTION!)
JWT_SECRET=changeme_in_production_please

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# ===== Database Configuration =====

# Database Type: sqlite or mysql (mariadb)
# Default: sqlite
DATABASE_TYPE=sqlite

# --- SQLite Configuration (default) ---
# SQLite database file path
DATABASE_URL=sqlite:data/data.db?mode=rwc

# --- MySQL/MariaDB Configuration ---
# If DATABASE_TYPE=mysql, you can use either:
# Option 1: Individual parameters (recommended for Docker Compose)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=pingora
# MYSQL_PASSWORD=pingora_password
# MYSQL_DATABASE=pingora_proxy

# Option 2: Full connection string
# DATABASE_URL=mysql://pingora:pingora_password@localhost:3306/pingora_proxy

# ===== Notes =====
# - For SQLite: Data is stored in the ./data directory
# - For MySQL: Make sure the database and user exist before starting
# - For Docker deployments: Use the service names (e.g., mysql) as hostnames
# - Always use strong passwords in production!
